# Replace these values on the future Linux server, not on the current Mac.
RUSTDESK_HOST=rustdesk.example.invalid
RUSTDESK_API_URL=https://api.example.invalid

# Loopback is deliberate. Set a reachable server/VPN IPv4 address only after
# configuring the host firewall. This does not expose the API port.
RUSTDESK_BIND_IP=127.0.0.1

# Bootstrap hbbs/hbbr first, then replace this with id_ed25519.pub.
# Never use id_ed25519 (the private key).
RUSTDESK_PUBLIC_KEY=REPLACE_WITH_HBBS_PUBLIC_KEY_BEFORE_STARTING_API
